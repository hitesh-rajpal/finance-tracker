# Copy this file to secrets.toml (same folder) for local runs.
# On Streamlit Community Cloud, paste the same values into
# App settings -> Secrets instead of committing a real secrets.toml.
#
# secrets.toml is gitignored — never commit real values.
#
# IMPORTANT: any top-level key (not inside a [table]) must be written BEFORE
# every [table] section below it — TOML silently nests it inside whichever
# table comes first otherwise, which breaks the value without an error.

# Fallback password, only used if [supabase_auth] below isn't set — once
# real login works you can delete this line entirely.
APP_PASSWORD = "change-me"

# Supabase: click "Connect" on your project dashboard -> "Session pooler" tab
# (port 5432). Do NOT use the direct-connection host here — Streamlit keeps
# this process running continuously and the free tier's direct-connection
# limit is easy to exhaust. Fields are kept separate (not one URL string)
# because a password containing "@" or other reserved characters makes a
# single connection-string URL ambiguous to parse.
[supabase]
host = "aws-0-ap-northeast-1.pooler.supabase.com"
port = 5432
dbname = "postgres"
user = "postgres.xxxxxxxxxxxx"
password = "your-db-password"

# Real email/password login (with working forgot-password). From your
# Supabase project: Settings -> API Keys -> "Publishable key" (starts
# sb_publishable_...) is the anon_key. The url is your project's base URL,
# https://<project-ref>.supabase.co. You also need to create your own login
# user under Authentication -> Users -> Add user in the Supabase dashboard —
# there's no public sign-up page in this app, only that one account can log in.
[supabase_auth]
url = "https://xxxxxxxxxxxx.supabase.co"
anon_key = "sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
